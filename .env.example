# Jira Data Center Konfiguration
# Kopiere diese Datei zu .env und fülle die Werte aus

JIRA_DOMAIN=https://deine-jira-instanz.example.com
JIRA_PAT_TOKEN=DEIN_PERSOENLICHES_TOKEN_HIER
JIRA_JQL=project = "PROJ" AND status != Closed ORDER BY created DESC

# Optional: Anpassungen
JIRA_MAX_RESULTS=50
JIRA_OUTPUT_FILE=jira_knowledge_source.json
JIRA_VERIFY_SSL=true
JIRA_MAX_RETRIES=3
JIRA_RETRY_DELAY=2.0
JIRA_TIMEOUT=30

# Optional: Epic-Link Custom Field
# Jira API Feld-ID, z.B. customfield_10100.
# Alternativ wird auch cf[10100] oder 10100 akzeptiert und automatisch normalisiert.
JIRA_EPIC_LINK_FIELD=customfield_10100

# Optional: Beliebige zusätzliche Custom Fields, die exportiert werden sollen.
#
# Empfohlen als JSON-Objekt:
# - Key links: frei wählbarer generischer Name im Export
# - Value rechts: Jira Field ID
#
# Für Xray Test Types z.B.:
# - Cucumber Scenario
# - Manual Test Steps
# - Generic Test Definition
#
# Akzeptierte Feld-ID-Formate:
# - customfield_10204
# - cf[10204]
# - 10204
#
JIRA_CUSTOM_FIELDS=cucumber_scenario=cf[10204],manual_test_steps=cf[10206],generic_test_definition=cf[10205]