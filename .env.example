# Jira Data Center Konfiguration
# Kopiere diese Datei zu .env und fülle die Werte aus

JIRA_DOMAIN=https://deine-jira-instanz.example.com
JIRA_PAT_TOKEN=DEIN_PERSOENLICHES_TOKEN_HIER
JIRA_JQL=project = "PROJ" AND status != Closed ORDER BY created DESC

# Optional: Anpassungen
JIRA_MAX_RESULTS=50
JIRA_OUTPUT_FILE=jira_knowledge_source.json
JIRA_VERIFY_SSL=true
JIRA_MAX_RETRIES=3
JIRA_RETRY_DELAY=2.0
JIRA_TIMEOUT=30